# Maintainer: jmarceno <https://github.com/jmarceno/gravaai>
pkgname=meeting-recorder
pkgver=@VERSION@
pkgrel=1
pkgdesc="Meeting recorder with AI transcription and summarization"
arch=('x86_64' 'aarch64')
url="https://github.com/jmarceno/gravaai"
license=('MIT')
depends=(
    'gtk4'
    'libadwaita'
    'libnotify'
    'ffmpeg'
    'libpulse'
    'curl'
    'hicolor-icon-theme'
)
makedepends=(
    'rust'
    'base-devel'
)
install=meeting-recorder.install
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo build --release --locked --manifest-path linux/Cargo.toml
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm 755 "linux/target/release/meeting-recorder" \
        "${pkgdir}/usr/bin/meeting-recorder"
    # NOTE: no launcher script — the Rust binary runs directly (client mode
    # ensures the daemon, then opens a window).

    install -Dm 644 linux/packaging/usr/share/applications/io.github.jmarceno.Gravaai.desktop \
        "${pkgdir}/usr/share/applications/io.github.jmarceno.Gravaai.desktop"

    # Tray artwork + icon tree the binary resolves at runtime.
    install -d "${pkgdir}/usr/share/meeting-recorder/tray"
    cp -r linux/assets/tray/. "${pkgdir}/usr/share/meeting-recorder/tray/"
    install -d "${pkgdir}/usr/share/meeting-recorder/icons"
    cp -r linux/assets/icons/. "${pkgdir}/usr/share/meeting-recorder/icons/"

    # Application icon (hicolor theme) under the Icon=meeting-recorder name the
    # desktop file references, so the shell renders it for the matched window.
    local icons_src="linux/assets/icons/hicolor"
    for size in 16 24 32 48 64 128 256; do
        install -Dm 644 "${icons_src}/${size}x${size}/apps/meeting-recorder.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/meeting-recorder.png"
    done
    install -Dm 644 "${icons_src}/scalable/apps/meeting-recorder.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/meeting-recorder.svg"
}
