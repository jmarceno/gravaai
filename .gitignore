# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/

# Logs
*.log

# Config with secrets
# (config.json contains API keys — never commit it)
~/.config/meeting-recorder/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.env

# Keystores (signing keys — never commit)
*.keystore
*.jks

# Android build output and local config
android/local.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/

# Claude Code session worktrees
.claude/worktrees/

# Coverage artifacts
.coverage
coverage.xml

# Gemini model test-script outputs (scripts/README.md)
/tmp/

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

/target
